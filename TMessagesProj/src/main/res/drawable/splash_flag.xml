<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash icon. The flag artwork already has its own
     padding, so no extra inset is needed; the system applies its circular mask. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/logo_flag"
    android:insetLeft="0%"
    android:insetTop="0%"
    android:insetRight="0%"
    android:insetBottom="0%" />
